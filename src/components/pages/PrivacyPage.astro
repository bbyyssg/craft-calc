---
import Base from "../../layouts/Base.astro";
import { SITE, type Lang } from "../../site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const C = {
  es: {
    title: "Política de privacidad",
    description: `Cómo trata ${SITE.name} tus datos: los cálculos se hacen en tu navegador.`,
    updated: "Última actualización",
    paras: [
      "Todas las calculadoras funcionan en tu navegador. Los números que escribes no se envían ni se guardan en ningún servidor.",
      "El alojamiento web puede registrar datos técnicos básicos (dirección IP, navegador, página visitada) para servir el sitio y protegerlo de abusos.",
      "Si el sitio muestra anuncios de Google AdSense, Google y sus socios pueden usar cookies para mostrar anuncios basados en tus visitas a este y otros sitios. Puedes desactivar la publicidad personalizada en <a href=\"https://adssettings.google.com\" rel=\"noopener\" target=\"_blank\">Configuración de anuncios de Google</a>. Más información: <a href=\"https://policies.google.com/technologies/partner-sites\" rel=\"noopener\" target=\"_blank\">cómo usa Google los datos</a>.",
    ],
  },
  pt: {
    title: "Política de privacidade",
    description: `Como o ${SITE.name} trata seus dados: os cálculos são feitos no seu navegador.`,
    updated: "Última atualização",
    paras: [
      "Todas as calculadoras funcionam no seu navegador. Os números que você digita não são enviados nem guardados em nenhum servidor.",
      "A hospedagem pode registrar dados técnicos básicos (endereço IP, navegador, página visitada) para servir o site e protegê-lo contra abusos.",
      "Se o site exibir anúncios do Google AdSense, o Google e seus parceiros podem usar cookies para mostrar anúncios com base nas suas visitas a este e a outros sites. Você pode desativar a publicidade personalizada nas <a href=\"https://adssettings.google.com\" rel=\"noopener\" target=\"_blank\">Configurações de anúncios do Google</a>. Saiba mais: <a href=\"https://policies.google.com/technologies/partner-sites\" rel=\"noopener\" target=\"_blank\">como o Google usa os dados</a>.",
    ],
  },
}[lang];
---

<Base lang={lang} title={C.title} description={C.description} page="privacy">
  <h1>{C.title}</h1>
  {C.paras.map((p) => <p set:html={p} />)}
  <p class="hint">{C.updated}: {SITE.lastReviewed}</p>
</Base>
